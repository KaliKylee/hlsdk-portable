+int CChub::IRelationship( CBaseEntity *pTarget )
+{
+	// afraid of the player once the player has hurt it
+	if( pTarget->IsPlayer() && ( m_afMemory & bits_MEMORY_PROVOKED ) )
+		return R_FR;
+	return CBaseMonster::IRelationship( pTarget );
+}
