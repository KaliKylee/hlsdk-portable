+void CChub::SetYawSpeed( void )
+{
+	switch( m_Activity )
+	{
+	case ACT_SWIM:
+		pev->yaw_speed = 150;
+		break;
+	case 19:
+	case 24:
+	case 58:
+		pev->yaw_speed = 0;
+		break;
+	default:
+		pev->yaw_speed = 70;
+		break;
+	}
+}
