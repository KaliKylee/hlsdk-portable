from waflib import Utils
import os

def options(opt):
	grp = opt.add_option_group('Client options')

	grp.add_option('--disable-goldsrc-support', action = 'store_false', dest = 'GOLDSOURCE_SUPPORT',
		default=True, help = 'disable GoldSource compatibility on i386 Win/Mac/Linux')

def configure(conf):
	if conf.env.DEST_OS == 'android':
		conf.check_cc(lib='log')

	if conf.env.DEST_OS in ['win32', 'linux', 'darwin'] and conf.env.DEST_CPU == 'x86':
		conf.env.GOLDSOURCE_SUPPORT = conf.options.GOLDSOURCE_SUPPORT
	else:
		conf.env.GOLDSOURCE_SUPPORT = False

	if conf.env.GOLDSOURCE_SUPPORT and not conf.env.DEST_OS == 'win32':
		conf.check_cc(lib='dl')

def build(bld):
	libs = []
	defines = ['CLIENT_DLL', 'USE_VGUI']
	defines += bld.env.EXPORT_DEFINES_LIST
	libs += ['vgui']
	if bld.env.DEST_OS == 'android':
		libs += ['LOG']

	# the idea is to always include original vgui headers set (because nobody is gonna port their code to freevgui headers)
	# but compile freevgui as a shared library here so we can link against it, but skip it from install
	includes = ['.',
		'../dlls',
		'../common',
		'../engine',
		'../pm_shared',
		'../game_shared',
		'../public',
